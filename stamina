local function atualizarVelocidade()
    local char = localPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if not velocidadeBaseOriginal then
        velocidadeBaseOriginal = humanoid.WalkSpeed
    end

    if ativadoVelocidade then
        humanoid.WalkSpeed = velocidadeBaseOriginal * multiplicador
    else
        humanoid.WalkSpeed = velocidadeBaseOriginal
    end
end

-- Lógica de Stamina Infinita Contínua
RunService.Heartbeat:Connect(function()
    if not ativadoStamina then return end
    local char = localPlayer.Character
    if not char then return end

    for _, nome in ipairs(NOMES_STAMINA) do
        if char:GetAttribute(nome) then
            char:SetAttribute(nome, char:GetAttribute("Max" .. nome) or 100)
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum:GetAttribute(nome) then
            hum:SetAttribute(nome, hum:GetAttribute("Max" .. nome) or 100)
        end
    end

    for _, obj in ipairs(char:GetDescendants()) do
        if (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
            for _, nome in ipairs(NOMES_STAMINA) do
                if string.find(string.lower(obj.Name), string.lower(nome)) then
                    obj.Value = obj:FindFirstChild("MaxValue") and obj.MaxValue.Value or 100
                end
            end
        end
    end
end)

speedBtn.MouseButton1Click:Connect(function()
    ativadoVelocidade = not ativadoVelocidade
    if ativadoVelocidade then
        speedBtn.Text = "⚡ VELOCIDADE (+5%): ON"
        TweenService:Create(speedBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(40, 180, 70)}):Play()
    else
        speedBtn.Text = "⚡ VELOCIDADE (+5%): OFF"
        TweenService:Create(speedBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}):Play()
    end
    atualizarVelocidade()
end)

stamBtn.MouseButton1Click:Connect(function()
    ativadoStamina = not ativadoStamina
    if ativadoStamina then
        stamBtn.Text = "♾️ STAMINA INFINITA: ON"
        TweenService:Create(stamBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(40, 180, 70)}):Play()
        footer.Text = "Stamina Infinita Ativada!"
        footer.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        stamBtn.Text = "♾️ STAMINA INFINITA: OFF"
        TweenService:Create(stamBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}):Play()
        footer.Text = "Stamina Desativada"
        footer.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end)

localPlayer.CharacterAdded:Connect(function()
    velocidadeBaseOriginal = nil
    task.wait(0.5)
    atualizarVelocidade()
end)
