{
  "AutoEscapeScript": {
    "Servicos": {
      "Players": "game:GetService('Players')",
      "VirtualInputManager": "game:GetService('VirtualInputManager')",
      "RunService": "game:GetService('RunService')",
      "UserInputService": "game:GetService('UserInputService')"
    },
    "Configuracao": {
      "NomeDaGui": "EscapeGui",
      "NomeDoIndicador": "TimingRing",
      "AutoEscapeAtivo": true
    },
    "Interface": {
      "ScreenGui": {
        "Nome": "AutoEscapeMenu",
        "ResetOnSpawn": false,
        "Parent": "playerGui"
      },
      "Botao": {
        "Nome": "ToggleButton",
        "Tamanho": [180, 42],
        "Posicao": [0.02, 0.2],
        "CorLigado": [30, 215, 96],
        "CorDesligado": [225, 45, 45],
        "TextoLigado": "Auto Escape: LIGADO [K]",
        "TextoDesligado": "Auto Escape: DESLIGADO [K]",
        "Fonte": "SourceSansBold",
        "TamanhoFonte": 16,
        "CorTexto": [255, 255, 255],
        "CantosArredondados": 8
      }
    },
    "Eventos": {
      "CliqueBotao": "Alterna autoEscapeAtivo e atualizaBotao()",
      "TeclaK": "Alterna autoEscapeAtivo e atualizaBotao()"
    },
    "Logica": {
      "RenderStepped": {
        "Condicao": "autoEscapeAtivo e nao pressionando",
        "BuscaGui": "EscapeGui",
        "BuscaAnel": "TimingRing",
        "VerificaCor": {
          "Verde": "cor.G > 0.6",
          "Vermelho": "cor.R < 0.4"
        },
        "Acao": "Pressiona tecla Espaço automaticamente"
      }
    }
  }
}
